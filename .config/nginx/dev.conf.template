server {
    server_name dev.${DOMAIN};
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    client_max_body_size 25m;

    include /etc/nginx/conf.d/snippets/ssl-params.conf;
    include /etc/nginx/conf.d/snippets/security-headers.conf;

    resolver 127.0.0.11 valid=5s;

    location / {
        set $php_frontend_dev "http://dev-php-frontend-dev-1:8000";
        proxy_pass $php_frontend_dev;
        include /etc/nginx/conf.d/snippets/proxy-params.conf;
        include /etc/nginx/conf.d/snippets/websocket-params.conf;
    }
}
